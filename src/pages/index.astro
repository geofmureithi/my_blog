---
import { getCollection } from 'astro:content'
import SiteLayout from '../layouts/SiteLayout.astro'
import siteMetadata from '../data/site-metadata'

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat(siteMetadata.locale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(date)
---

<SiteLayout>
  <div class="mt-8 divide-y divide-gray-200 dark:divide-gray-700 md:mt-16">
    <div class="my-4 space-y-2 pt-6 pb-8 md:space-y-5 xl:grid xl:grid-cols-3">
      <div class="pr-8 xl:col-span-2">
        <p class="mb-4 bg-clip-text text-4xl font-extrabold leading-[60px] tracking-tight text-transparent bg-gradient-to-r from-green-600 to-red-600 dark:bg-gradient-to-l dark:from-gray-500 dark:to-lime-600 md:text-6xl md:leading-[86px]">
          Habari!
        </p>
        <div class="text-lg leading-8 text-gray-600 dark:text-gray-400">
          <h1 class="text-neutral-900 dark:text-neutral-200">
            I'm Njuguna Mureithi, a Senior Engineer from Nairobi, Kenya.
          </h1>
          <p class="mt-4 mb-8">
            I started my coding journey in 2007 and sold my first software in 2010<br />
            I write code every possible day and have done so gaining 10+ years of real work experience.<br />
            I enjoy learning new concepts and languages.<br />
            I'm currently involved a lot with Rust and Javascript with a little bit of C.
          </p>
          <p class="my-8">Karibu!</p>
        </div>
      </div>
      <div class="hidden xl:block">
        <img
          src="/static/images/who-am-i.webp"
          alt="hero"
          width="1280"
          height="960"
          class="rounded object-cover object-center"
        />
      </div>
    </div>
  </div>
  <div class="divide-y divide-gray-200 dark:divide-gray-700">
    <div class="space-y-2 pt-6 pb-8 md:space-y-5">
      <h1 class="text-2xl font-extrabold leading-9 tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl sm:leading-10 md:text-4xl md:leading-14">
        Latest Posts
      </h1>
      <p class="text-lg leading-7 text-gray-500 dark:text-gray-400">{siteMetadata.description}</p>
    </div>
    <ul class="divide-y divide-gray-200 dark:divide-gray-700">
      {posts.slice(0, 5).map((post) => (
        <li class="py-12">
          <article>
            <div class="space-y-2 xl:grid xl:grid-cols-4 xl:items-baseline xl:space-y-0">
              <dl>
                <dt class="sr-only">Published on</dt>
                <dd class="text-base font-medium leading-6 text-gray-500 dark:text-gray-400">
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                </dd>
              </dl>
              <div class="space-y-5 xl:col-span-3">
                <div class="space-y-6">
                  <div>
                    <h2 class="text-2xl font-bold leading-8 tracking-tight">
                      <a class="text-gray-900 dark:text-gray-100" href={`/blog/${post.id}`}>
                        {post.data.title}
                      </a>
                    </h2>
                    <div class="flex flex-wrap">
                      {post.data.tags.map((tag) => (
                        <a
                          href={`/tags/${tag.toLowerCase().replaceAll(' ', '-')}`}
                          class="mr-3 text-sm font-medium uppercase text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
                        >
                          {tag}
                        </a>
                      ))}
                    </div>
                  </div>
                  {post.data.summary && (
                    <div class="prose max-w-none text-gray-500 dark:text-gray-400">{post.data.summary}</div>
                  )}
                </div>
                <div class="text-base font-medium leading-6">
                  <a
                    href={`/blog/${post.id}`}
                    aria-label={`Read "${post.data.title}"`}
                    class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
                  >
                    Read more →
                  </a>
                </div>
              </div>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>
</SiteLayout>
