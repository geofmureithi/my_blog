---
import SiteLayout from '../layouts/SiteLayout.astro'
import siteMetadata from '../data/site-metadata'
---

<SiteLayout
  title={`404 | ${siteMetadata.title}`}
  description="This page could not be found. Browse the blog or return to the homepage."
  robots="noindex, follow, max-image-preview:large"
>
  <section class="mx-auto flex max-w-2xl flex-col items-center py-12 text-center md:py-20">
    <!-- Ferris the crab, looking a little lost -->
    <svg
      class="h-32 w-32 md:h-40 md:w-40"
      viewBox="0 0 200 150"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <!-- legs -->
      <g stroke="#c73e00" stroke-width="5" stroke-linecap="round">
        <path d="M58 96 L34 112" />
        <path d="M60 104 L38 124" />
        <path d="M142 96 L166 112" />
        <path d="M140 104 L162 124" />
      </g>
      <!-- claws -->
      <g fill="#f74c00">
        <path d="M40 70 q-18 -6 -24 10 q-4 14 10 16 q10 1 10 -8 q0 -6 -6 -6 q8 -6 10 -12z" />
        <path d="M160 70 q18 -6 24 10 q4 14 -10 16 q-10 1 -10 -8 q0 -6 6 -6 q-8 -6 -10 -12z" />
      </g>
      <!-- body -->
      <ellipse cx="100" cy="92" rx="52" ry="34" fill="#f74c00" />
      <ellipse cx="100" cy="92" rx="52" ry="34" fill="#000" opacity="0.06" />
      <!-- eye stalks -->
      <g stroke="#f74c00" stroke-width="6" stroke-linecap="round">
        <path d="M86 62 L84 44" />
        <path d="M114 62 L116 44" />
      </g>
      <!-- eyes (white) -->
      <circle cx="84" cy="40" r="9" fill="#fff" />
      <circle cx="116" cy="40" r="9" fill="#fff" />
      <!-- pupils (looking away, confused) -->
      <circle cx="80" cy="42" r="3.5" fill="#1a1a1a" />
      <circle cx="120" cy="42" r="3.5" fill="#1a1a1a" />
      <!-- unsure mouth -->
      <path
        d="M90 102 q10 8 20 0"
        stroke="#7a2600"
        stroke-width="4"
        stroke-linecap="round"
        fill="none"
      />
    </svg>

    <p class="mt-6 text-7xl font-extrabold tracking-tight text-gray-900 dark:text-gray-100 md:text-8xl">
      404
    </p>
    <h1 class="mt-3 text-2xl font-bold tracking-tight text-gray-900 dark:text-gray-100 md:text-3xl">
      This page moved out of scope.
    </h1>
    <p class="mt-3 max-w-md text-base leading-7 text-gray-500 dark:text-gray-400">
      The borrow checker couldn't save this one — it got dropped before you arrived. No
      <code class="rounded bg-gray-100 px-1 py-0.5 font-mono text-sm text-primary-600 dark:bg-gray-800 dark:text-primary-400">
        unwrap()
      </code>
      is going to bring it back.
    </p>

    <!-- Should we solve this in Rust? -->
    <div class="mt-8 w-full max-w-lg overflow-hidden rounded-xl border border-gray-200 bg-gray-950 text-left dark:border-gray-800">
      <div class="flex items-center gap-2 border-b border-white/10 px-4 py-2.5">
        <span class="h-3 w-3 rounded-full bg-red-500"></span>
        <span class="h-3 w-3 rounded-full bg-yellow-400"></span>
        <span class="h-3 w-3 rounded-full bg-green-500"></span>
        <span class="ml-2 font-mono text-xs text-gray-400">should_we_solve_it_in_rust.rs</span>
      </div>
      <pre class="overflow-x-auto px-4 py-4 font-mono text-sm leading-6 text-gray-200"><code><span class="text-teal-400">fn</span> <span class="text-blue-300">find_page</span>(url: <span class="text-teal-400">&amp;</span><span class="text-orange-300">str</span>) -&gt; <span class="text-teal-300">Result</span>&lt;Page, NotFound&gt; &#123;
    pages
        .<span class="text-blue-300">get</span>(url)
        .<span class="text-blue-300">ok_or</span>(NotFound) <span class="text-gray-500">// 🦀 nothing here, chief</span>
&#125;

<span class="text-gray-500">// thread 'main' panicked at '404: page not found'</span>
<span class="text-gray-500">// note: run with `RUST_BACKTRACE=1` ... or just go home</span></code></pre>
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <button
        id="go-back"
        type="button"
        class="inline-flex items-center rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:border-primary-500 hover:text-primary-500 dark:border-gray-600 dark:text-gray-200 dark:hover:border-primary-400 dark:hover:text-primary-400"
      >
        ← Go back
      </button>
      <a
        href="/"
        class="inline-flex items-center rounded-lg bg-primary-500 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-primary-600"
      >
        Take me home
      </a>
    </div>
  </section>

  <script is:inline>
    document.getElementById('go-back')?.addEventListener('click', () => {
      if (window.history.length > 1) {
        window.history.back()
      } else {
        window.location.href = '/'
      }
    })
  </script>
</SiteLayout>
