---
import MoonIcon from './icons/Moon.astro'
import SunIcon from './icons/Sun.astro'
import { themeSwitcherId } from '../lib/theme'
---

<button
  id={themeSwitcherId}
  type="button"
  role="switch"
  aria-checked="false"
  aria-label="Dark mode"
  class="theme-switcher relative inline-flex h-8 w-14 max-w-full shrink-0 cursor-pointer items-center rounded-full border border-gray-300 bg-gray-200 touch-manipulation transition-colors hover:border-primary-500 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:outline-none dark:border-gray-700 dark:bg-gray-700 dark:hover:border-primary-400"
>
  <span class="theme-switcher-thumb pointer-events-none absolute z-10 inline-flex items-center justify-center rounded-full bg-white text-gray-800 shadow-sm ring-1 ring-black/5 dark:bg-gray-900 dark:text-gray-100 dark:ring-white/10">
    <SunIcon class="h-4 w-4 dark:hidden" aria-hidden="true" />
    <MoonIcon class="hidden h-4 w-4 dark:block" aria-hidden="true" />
  </span>
</button>

<style>
  .theme-switcher {
    --switch-pad: 1px;
    -webkit-tap-highlight-color: transparent;
  }

  .theme-switcher::before {
    content: '';
    position: absolute;
    inset: -0.375rem;
  }

  .theme-switcher-thumb {
    top: 50%;
    left: var(--switch-pad);
    height: calc(100% - var(--switch-pad) * 2);
    aspect-ratio: 1;
    transform: translateY(-50%);
    transition:
      left 200ms ease,
      transform 200ms ease;
  }

  :global(.dark) .theme-switcher-thumb {
    left: calc(100% - var(--switch-pad));
    transform: translate(-100%, -50%);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-switcher-thumb {
      transition: none;
    }
  }
</style>
