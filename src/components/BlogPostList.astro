---
import siteMetadata from '../data/site-metadata'
import { tagSlug } from '../lib/tags'

interface Props {
  posts: Array<{
    id: string
    data: {
      title: string
      date: Date
      tags: string[]
      summary?: string
    }
  }>
  title: string
  description?: string
  search?: boolean
}

const { posts, title, description, search = true } = Astro.props as Props
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat(siteMetadata.locale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(date)
---

<div class="divide-y divide-gray-200 dark:divide-gray-700">
  <header class="space-y-2 pt-6 pb-8 md:space-y-5">
    <h1 class="text-3xl font-extrabold leading-9 tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl sm:leading-10 md:text-6xl md:leading-14">
      {title}
    </h1>
    {description && <p class="text-lg leading-7 text-gray-500 dark:text-gray-400">{description}</p>}
    {search && (
      <div class="relative max-w-lg">
        <label class="sr-only" for="article-search">
          Search articles
        </label>
        <input
          id="article-search"
          type="search"
          placeholder="Search articles"
          class="block w-full rounded-md border border-gray-300 bg-white py-2 pl-4 pr-10 text-gray-900 placeholder-gray-500 focus:border-primary-500 focus:outline-hidden focus:ring-primary-500 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100 dark:placeholder-gray-400"
        />
        <svg
          aria-hidden="true"
          class="pointer-events-none absolute right-3 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-500"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M8.5 3a5.5 5.5 0 103.48 9.76l3.63 3.63a.75.75 0 101.06-1.06l-3.63-3.63A5.5 5.5 0 008.5 3zM4.5 8.5a4 4 0 118 0 4 4 0 01-8 0z"
            clip-rule="evenodd"
          />
        </svg>
      </div>
    )}
  </header>
  <ul id="article-list">
    {posts.map((post) => (
      <li
        class="py-4"
        data-article
        data-search={`${post.data.title} ${post.data.summary || ''} ${post.data.tags.join(' ')}`.toLowerCase()}
      >
        <article class="xl:grid xl:grid-cols-4">
          <dl>
            <dt class="sr-only">Published on</dt>
            <dd class="pt-2 text-base font-medium leading-6 text-gray-500 dark:text-gray-400">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            </dd>
          </dl>
          <div class="xl:col-span-3">
            <div>
              <h3 class="text-2xl font-bold leading-8 tracking-tight">
                <a class="text-gray-900 dark:text-gray-100" href={`/blog/${post.id}`}>
                  {post.data.title}
                </a>
              </h3>
              <div class="flex flex-wrap">
                {post.data.tags.map((tag) => (
                  <a
                    href={`/tags/${tagSlug(tag)}`}
                    class="mr-3 text-sm font-medium uppercase text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
                  >
                    {tag}
                  </a>
                ))}
              </div>
              {post.data.summary && (
                <p class="prose mt-3 max-w-none text-gray-500 dark:text-gray-400">
                  {post.data.summary}
                </p>
              )}
            </div>
          </div>
        </article>
      </li>
    ))}
  </ul>
</div>

{search && <script is:inline>
  const searchInput = document.getElementById('article-search')
  const articleItems = [...document.querySelectorAll('[data-article]')]
  searchInput.addEventListener('input', () => {
    const query = searchInput.value.trim().toLowerCase()
    articleItems.forEach((item) => {
      const matches = item.dataset.search.includes(query)
      item.hidden = !matches
    })
  })
</script>}
