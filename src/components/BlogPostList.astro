---
import siteMetadata from '../data/site-metadata'
import { tagSlug } from '../lib/tags'
import ReadMoreIcon from './icons/ReadMore.astro'

interface Props {
  posts: Array<{
    id: string
    data: {
      title: string
      date: Date
      tags: string[]
      summary?: string
    }
  }>
  title: string
  description?: string
  search?: boolean
}

const { posts, title, description, search = true } = Astro.props as Props
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat(siteMetadata.locale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(date)
---

<div>
  <header class="pt-6">
    <h1 class="text-2xl font-extrabold tracking-tight text-gray-900 sm:text-3xl dark:text-gray-100">
      {title}
    </h1>
    {description && <p class="mt-2 text-gray-500 dark:text-gray-400">{description}</p>}
    {search && (
      <div class="relative mt-6 max-w-sm">
        <label class="sr-only" for="article-search">
          Search articles
        </label>
        <input
          id="article-search"
          type="search"
          placeholder="Search articles"
          class="block w-full rounded-lg border border-gray-300 bg-transparent py-1.5 pr-9 pl-3 text-sm text-gray-900 placeholder-gray-500 focus:border-primary-500 focus:outline-hidden dark:border-gray-600 dark:text-gray-100 dark:placeholder-gray-400"
        />
        <svg
          aria-hidden="true"
          class="pointer-events-none absolute top-1/2 right-3 h-4 w-4 -translate-y-1/2 text-gray-500"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M8.5 3a5.5 5.5 0 103.48 9.76l3.63 3.63a.75.75 0 101.06-1.06l-3.63-3.63A5.5 5.5 0 008.5 3zM4.5 8.5a4 4 0 118 0 4 4 0 01-8 0z"
            clip-rule="evenodd"
          />
        </svg>
      </div>
    )}
  </header>
  <ul id="article-list" class="mt-8 flex flex-col gap-8">
    {posts.map((post) => (
      <li
        data-article
        data-search={`${post.data.title} ${post.data.summary || ''} ${post.data.tags.join(' ')}`.toLowerCase()}
      >
        <article>
          <div class="flex items-baseline justify-between gap-4">
            <h3
              class="min-w-0 text-xl font-bold tracking-tight text-gray-900 dark:text-gray-100"
              transition:name={`post-${post.id}`}
            >
              <a class="hover:text-primary-500" href={`/blog/${post.id}`}>
                {post.data.title}
              </a>
            </h3>
            <time
              datetime={post.data.date.toISOString()}
              class="shrink-0 text-sm text-gray-500 dark:text-gray-400"
            >
              {formatDate(post.data.date)}
            </time>
          </div>
          <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
            {post.data.tags.map((tag) => (
              <a
                href={`/tags/${tagSlug(tag)}`}
                class="text-xs font-medium uppercase tracking-wide text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
              >
                {tag}
              </a>
            ))}
          </div>
          {post.data.summary && (
            <p class="mt-3 text-sm leading-6 text-gray-500 dark:text-gray-400">
              {post.data.summary}
            </p>
          )}
          <a
            href={`/blog/${post.id}`}
            aria-label={`Read ${post.data.title}`}
            class="mt-4 inline-flex w-fit items-center rounded-lg border border-gray-300 px-3 py-1.5 text-sm font-semibold text-gray-900 hover:border-primary-500 dark:border-gray-600 dark:text-gray-100 dark:hover:border-primary-400"
          >
            Read more
            <ReadMoreIcon class="ml-1 h-5 w-5" aria-hidden="true" />
          </a>
        </article>
      </li>
    ))}
  </ul>
</div>

{search && <script is:inline>
  const searchInput = document.getElementById('article-search')
  const articleItems = [...document.querySelectorAll('[data-article]')]
  searchInput.addEventListener('input', () => {
    const query = searchInput.value.trim().toLowerCase()
    articleItems.forEach((item) => {
      const matches = item.dataset.search.includes(query)
      item.hidden = !matches
    })
  })
</script>}
