---
import { getEntry, render } from 'astro:content'
import SocialLinks from '../components/SocialLinks.astro'
import SiteLayout from '../layouts/SiteLayout.astro'
import siteMetadata from '../data/site-metadata'
import { personEntity } from '../lib/structured-data'

const author = await getEntry('authors', 'default')
const { Content } = await render(author)
const personData = { '@context': 'https://schema.org', ...personEntity(author.data) }
const aboutLinkClass =
  'inline-flex h-12 w-12 items-center justify-center rounded-xl border border-gray-300 transition hover:border-primary-500 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:outline-none dark:border-gray-600 dark:hover:border-primary-400'
const aboutSocials = [
  author.data.email
    ? { href: `mailto:${author.data.email}`, label: 'Email', icon: 'email' as const }
    : null,
  author.data.github
    ? { href: author.data.github, label: 'GitHub', icon: 'github' as const }
    : null,
  author.data.linkedin
    ? { href: author.data.linkedin, label: 'LinkedIn', icon: 'linkedin' as const }
    : null,
  author.data.twitter ? { href: author.data.twitter, label: 'X', icon: 'x' as const } : null,
].filter((link) => link !== null)
---

<SiteLayout
  title={`About - ${siteMetadata.author}`}
  description={`About me - ${siteMetadata.author}`}
  structuredData={personData}
>
  <div>
    <header class="space-y-2 pt-6 pb-8 md:space-y-5">
      <h1 class="text-3xl font-extrabold leading-9 tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl sm:leading-10 md:text-6xl md:leading-14">
        About
      </h1>
    </header>
    <div class="items-start space-y-2 xl:grid xl:grid-cols-3 xl:gap-x-8 xl:space-y-0">
      <div class="flex flex-col items-center pt-8">
        <img
          src={author.data.avatar}
          alt={author.data.name}
          width="192"
          height="192"
          class="h-48 w-48 rounded-full"
        />
        <h2 class="pt-4 pb-2 text-2xl font-bold leading-8 tracking-tight">{author.data.name}</h2>
        {author.data.occupation && (
          <p class="text-gray-500 dark:text-gray-400">{author.data.occupation}</p>
        )}
        {author.data.company && (
          <p class="text-gray-500 dark:text-gray-400">{author.data.company}</p>
        )}
        <div class="flex gap-3 pt-6 text-gray-900 dark:text-gray-100">
          <SocialLinks links={aboutSocials} linkClass={aboutLinkClass} iconClass="h-6 w-6" />
        </div>
      </div>
      <div class="prose max-w-none pt-8 pb-8 dark:prose-dark xl:col-span-2">
        <Content />
      </div>
    </div>
  </div>
</SiteLayout>
