---
import SiteLayout from '../layouts/SiteLayout.astro'
import ProjectCard from '../components/ProjectCard.astro'
import siteMetadata from '../data/site-metadata'
import projects from '../data/projects'
---

<SiteLayout title={`Projects - ${siteMetadata.author}`} description={siteMetadata.description}>
  <header class="space-y-3 pt-6 pb-8">
    <p class="text-sm font-semibold uppercase tracking-[0.22em] text-primary-500">Portfolio</p>
    <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-5xl dark:text-gray-100">
      Projects
    </h1>
    <p class="max-w-2xl text-lg leading-8 text-gray-500 dark:text-gray-400">
      Some of the things I have been working on. Open source libraries for jobs, payments, and the
      platforms around them.
    </p>
  </header>
  <div class="grid gap-4 pb-8 sm:grid-cols-2 lg:grid-cols-3">
    {projects.map((project) => (
      <ProjectCard {...project} />
    ))}
  </div>
</SiteLayout>
