---
import SiteLayout from '../layouts/SiteLayout.astro'
import siteMetadata from '../data/site-metadata'
---

<SiteLayout
  title={`404 | ${siteMetadata.title}`}
  description="This page could not be found. Browse the blog or return to the homepage."
  robots="noindex, follow, max-image-preview:large"
>
  <section class="flex flex-col items-start justify-start md:mt-24 md:flex-row md:items-center md:justify-center md:space-x-6">
    <div class="space-x-2 pt-6 pb-8 md:space-y-5">
      <h1 class="text-6xl font-extrabold leading-9 tracking-tight text-gray-900 dark:text-gray-100 md:border-r-2 md:px-6 md:text-8xl md:leading-14">
        404
      </h1>
    </div>
    <div class="max-w-md">
      <p class="mb-4 text-xl font-bold leading-normal md:text-2xl">
        Sorry, we couldn't find this page.
      </p>
      <p class="mb-8">You can find plenty of other things on the homepage.</p>
      <a
        href="/"
        class="inline rounded-lg border border-transparent bg-blue-600 px-4 py-2 text-sm font-medium leading-5 text-white shadow transition-colors duration-150 hover:bg-blue-700 focus:outline-hidden dark:hover:bg-blue-500"
      >
        Back to homepage
      </a>
    </div>
  </section>
</SiteLayout>
