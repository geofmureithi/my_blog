{
  "name": "tailwind-nextjs-starter-blog",
  "version": "1.5.3",
  "private": true,
  "scripts": {
    "start": "next dev",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "pnpm run sitemap && pnpm run rss",
    "sitemap": "cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/generate-sitemap.mjs",
    "rss": "cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/generate-rss.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "lint": "eslint --fix pages components lib layouts scripts",
    "prepare": "husky install"
  },
  "dependencies": {
    "@fontsource/inter": "4.5.2",
    "@mailchimp/mailchimp_marketing": "^3.0.58",
    "@tailwindcss/forms": "^0.4.0",
    "@tailwindcss/typography": "^0.5.0",
    "autoprefixer": "^10.4.0",
    "contentlayer2": "0.5.8",
    "esbuild": "^0.25.12",
    "github-slugger": "^1.3.0",
    "gray-matter": "^4.0.2",
    "image-size": "1.0.0",
    "js-yaml": "^5.5.0",
    "katex": "^0.19.0",
    "mdast-util-to-string": "^4.0.0",
    "mdx-bundler": "^10.1.1",
    "next": "16.4.2",
    "next-contentlayer2": "0.5.8",
    "next-themes": "^0.4.6",
    "postcss": "^8.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reading-time": "1.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^7.0.1",
    "rehype-preset-minify": "7.0.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.0.18",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.2",
    "@svgr/webpack": "^8.1.0",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/tailwindcss": "^2.2.0",
    "@types/unist": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "cross-env": "^7.0.3",
    "dedent": "^0.7.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "file-loader": "^6.0.0",
    "globby": "11.0.3",
    "husky": "^6.0.0",
    "inquirer": "^8.1.1",
    "lint-staged": "^11.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "0.6.11",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.6.0",
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  }
}
