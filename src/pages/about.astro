---
import { getEntry, render } from 'astro:content'
import SiteLayout from '../layouts/SiteLayout.astro'
import siteMetadata from '../data/site-metadata'

const author = await getEntry('authors', 'default')
const { Content } = await render(author)
---

<SiteLayout title={`About - ${siteMetadata.author}`} description={`About me - ${siteMetadata.author}`}>
  <div class="divide-y divide-gray-200 dark:divide-gray-700">
    <header class="space-y-2 pt-6 pb-8 md:space-y-5">
      <h1 class="text-3xl font-extrabold leading-9 tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl sm:leading-10 md:text-6xl md:leading-14">
        About
      </h1>
    </header>
    <div class="items-start space-y-2 xl:grid xl:grid-cols-3 xl:gap-x-8 xl:space-y-0">
      <div class="flex flex-col items-center pt-8">
        <img
          src={author.data.avatar}
          alt={author.data.name}
          width="192"
          height="192"
          class="h-48 w-48 rounded-full"
        />
        <h2 class="pt-4 pb-2 text-2xl font-bold leading-8 tracking-tight">{author.data.name}</h2>
        {author.data.occupation && <p class="text-gray-500 dark:text-gray-400">{author.data.occupation}</p>}
        {author.data.company && <p class="text-gray-500 dark:text-gray-400">{author.data.company}</p>}
        <div class="flex space-x-3 pt-6">
          {author.data.email && <a href={`mailto:${author.data.email}`} aria-label="Email"><img class="h-6 w-6 dark:invert" src="/icons/mail.svg" alt="" /></a>}
          {author.data.github && <a href={author.data.github} aria-label="GitHub"><img class="h-6 w-6 dark:invert" src="/icons/github.svg" alt="" /></a>}
          {author.data.linkedin && <a href={author.data.linkedin} aria-label="LinkedIn"><img class="h-6 w-6 dark:invert" src="/icons/linkedin.svg" alt="" /></a>}
          {author.data.twitter && <a href={author.data.twitter} aria-label="Twitter"><img class="h-6 w-6 dark:invert" src="/icons/twitter.svg" alt="" /></a>}
        </div>
      </div>
      <div class="prose max-w-none pt-8 pb-8 dark:prose-dark xl:col-span-2">
        <Content />
      </div>
    </div>
  </div>
</SiteLayout>
