---
import { getCollection } from 'astro:content'
import SiteLayout from '../layouts/SiteLayout.astro'
import ProjectCard from '../components/ProjectCard.astro'
import siteMetadata from '../data/site-metadata'
import projects from '../data/projects'
import { tagSlug } from '../lib/tags'
import RustIcon from '../components/icons/Rust.astro'
import JavaScriptIcon from '../components/icons/JavaScript.astro'
import CIcon from '../components/icons/C.astro'
import NodeIcon from '../components/icons/Node.astro'
import PostgresIcon from '../components/icons/Postgres.astro'
import ReadMoreIcon from '../components/icons/ReadMore.astro'

const posts = (await getCollection('blog', ({ data }) => !data.draft)).toSorted(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat(siteMetadata.locale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(date)
const skills = [
  { name: 'Rust', Icon: RustIcon },
  { name: 'JavaScript', Icon: JavaScriptIcon },
  { name: 'C', Icon: CIcon },
  { name: 'Node', Icon: NodeIcon },
  { name: 'Postgres', Icon: PostgresIcon },
]
---

<SiteLayout>
  <section>
    <div class="grid items-start gap-8 pt-8 md:grid-cols-[minmax(0,1.15fr)_minmax(16rem,0.85fr)] md:gap-12 md:pt-14">
      <div>
        <h1 class="max-w-2xl text-2xl font-semibold leading-snug tracking-tight text-gray-900 sm:text-4xl sm:leading-tight dark:text-gray-100">
          I'm Njuguna Mureithi.
        </h1>
        <p class="mt-2 max-w-2xl text-2xl leading-snug tracking-tight text-gray-600 sm:text-4xl sm:leading-tight dark:text-gray-300">
          I build software for payments, automation, and the web.
        </p>
        <ul class="mt-8 flex flex-wrap gap-2 text-gray-900 dark:text-gray-100">
          {skills.map(({ name, Icon }) => (
            <li>
              <span
                aria-label={name}
                class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-gray-300 dark:border-gray-600"
              >
                <Icon class="h-4 w-4" aria-hidden="true" />
              </span>
            </li>
          ))}
        </ul>
      </div>
      <p class="max-w-md text-base leading-7 text-gray-600 md:justify-self-end md:pt-24 md:text-right dark:text-gray-400">
        I started writing code in 2007 and sold my first program in 2010. These days the work is
        mostly Rust and JavaScript, with a little C when the hardware asks for it. Karibu.
      </p>
    </div>
    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href="/projects"
        class="inline-flex items-center rounded-lg bg-primary-500 px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-600"
      >
        Selected work
      </a>
      <a
        href="/about"
        class="inline-flex items-center rounded-lg border border-gray-300 px-5 py-2.5 text-sm font-semibold text-gray-800 hover:border-primary-500 dark:border-gray-600 dark:text-gray-100"
      >
        About
      </a>
    </div>
  </section>

  <section class="mt-16">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight text-gray-900 sm:text-3xl dark:text-gray-100">
          Selected work
        </h2>
        <p class="mt-2 text-gray-500 dark:text-gray-400">Libraries and APIs I maintain.</p>
      </div>
      <a
        href="/projects"
        class="text-sm font-medium text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
      >
        View all projects
      </a>
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <ProjectCard {...project} />
      ))}
    </div>
  </section>

  <section class="mt-16">
    <div>
      <h2 class="text-2xl font-extrabold tracking-tight text-gray-900 sm:text-3xl dark:text-gray-100">
        Latest writing
      </h2>
      <p class="mt-2 text-gray-500 dark:text-gray-400">{siteMetadata.description}</p>
    </div>
    <ul class="mt-6 grid gap-4 md:grid-cols-2">
      {posts.slice(0, 4).map((post) => (
        <li>
          <article class="flex h-full flex-col rounded-2xl border border-gray-200 p-6 dark:border-gray-800">
            <time
              datetime={post.data.date.toISOString()}
              class="text-sm text-gray-500 dark:text-gray-400"
            >
              {formatDate(post.data.date)}
            </time>
            <h3
              class="mt-3 text-xl font-bold leading-7 tracking-tight text-gray-900 dark:text-gray-100"
              transition:name={`post-${post.id}`}
            >
              <a href={`/blog/${post.id}`} class="hover:text-primary-500">
                {post.data.title}
              </a>
            </h3>
            <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1">
              {post.data.tags.map((tag) => (
                <a
                  href={`/tags/${tagSlug(tag)}`}
                  class="text-xs font-medium uppercase tracking-wide text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
                >
                  {tag}
                </a>
              ))}
            </div>
            {post.data.summary && (
              <p class="mt-3 flex-1 text-sm leading-6 text-gray-500 dark:text-gray-400">
                {post.data.summary}
              </p>
            )}
            <a
              href={`/blog/${post.id}`}
              aria-label={`Read ${post.data.title}`}
              class="mt-6 inline-flex w-fit items-center rounded-lg border border-gray-300 px-3 py-1.5 text-sm font-semibold text-primary-500 hover:border-primary-500 dark:border-gray-600 dark:hover:border-primary-400"
            >
              Read more
              <ReadMoreIcon class="ml-1 h-5 w-5" aria-hidden="true" />
            </a>
          </article>
        </li>
      ))}
    </ul>
  </section>
</SiteLayout>
