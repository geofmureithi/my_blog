---
interface Props {
  class?: string
}

const { class: className = 'h-14 w-14 sm:h-16 sm:w-16 md:h-[4.5rem] md:w-[4.5rem]' } = Astro.props
---

<span
  class:list={[
    'inline-flex shrink-0 items-center justify-center rounded-full border border-gray-300 text-gray-500 dark:border-gray-700 dark:text-gray-400',
    className,
  ]}
>
  <slot />
</span>
