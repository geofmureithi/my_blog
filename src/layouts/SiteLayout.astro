---
import { ClientRouter } from 'astro:transitions'
import '@fontsource/inter/variable-full.css'
import '../styles/global.css'
import '../styles/prism.css'
import logo from '../assets/logo.svg?raw'
import SocialLinks from '../components/SocialLinks.astro'
import siteMetadata from '../data/site-metadata'
import { pageTransition } from '../lib/page-transition'
import { themeHeadScript } from '../lib/theme'

interface Props {
  title?: string
  description?: string
  robots?: string
  canonical?: string
  ogType?: string
  ogImage?: string
  ogImages?: string[]
  ogImageAlt?: string
  ogImageMetadata?: Array<{ width?: number; height?: number; type?: string }>
  articlePublished?: string
  articleModified?: string
  articleSection?: string
  articleTags?: string[]
  structuredData?: Record<string, unknown>
  tagFeedHref?: string
  tagFeedTitle?: string
}

const canonicalPath = Astro.url.pathname.replace(/\/index(?:\.html)?$/, '/').replace(/\.html$/, '')
const {
  title = siteMetadata.title,
  description = siteMetadata.description,
  robots = 'index, follow, max-image-preview:large',
  canonical = siteMetadata.siteUrl + canonicalPath,
  ogType = 'website',
  ogImage,
  ogImages,
  ogImageAlt = `${title} — ${siteMetadata.author}`,
  ogImageMetadata,
  articlePublished,
  articleModified,
  articleSection,
  articleTags = [],
  structuredData,
  tagFeedHref,
  tagFeedTitle,
} = Astro.props as Props
const imageSources = ogImages ?? [ogImage ?? siteMetadata.socialBanner]
const absoluteOgImages = imageSources.map(
  (image) => new URL(image, siteMetadata.ogImageBaseUrl).href
)
const defaultImageMetadata = [{ width: 1200, height: 600, type: 'image/png' }]
const imageMetadata =
  ogImageMetadata ??
  (imageSources.length === 1 && imageSources[0] === siteMetadata.socialBanner
    ? defaultImageMetadata
    : [])
const navLinks = [
  { href: '/blog', title: 'Blog' },
  { href: '/projects', title: 'Projects' },
  { href: '/about', title: 'About' },
]
const footerLinks = [
  { href: '/blog', title: 'Blog' },
  { href: '/tags', title: 'Tags' },
  { href: '/projects', title: 'Projects' },
  { href: '/about', title: 'About' },
]
const socialLinkClass =
  'inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-gray-300 text-gray-500 transition hover:border-primary-500 hover:text-primary-500 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:outline-none dark:border-gray-700 dark:text-gray-400 dark:hover:border-primary-400'
const footerSocials = [
  { href: `mailto:${siteMetadata.email}`, label: 'Email', icon: 'email' as const },
  { href: siteMetadata.github, label: 'GitHub', icon: 'github' as const },
  { href: siteMetadata.linkedin, label: 'LinkedIn', icon: 'linkedin' as const },
  { href: siteMetadata.twitter, label: 'X', icon: 'x' as const },
  { href: siteMetadata.sessionize, label: 'Sessionize', icon: 'sessionize' as const },
]
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robots} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={siteMetadata.title} href="/feed.xml" />
    {tagFeedHref && (
      <link rel="alternate" type="application/rss+xml" title={tagFeedTitle} href={tagFeedHref} />
    )}
    <link rel="apple-touch-icon" sizes="76x76" href="/static/favicons/apple-touch-icon.png" />
    <link rel="icon" href="/static/favicons/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/static/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/static/favicons/favicon-16x16.png" />
    <link rel="manifest" href="/static/favicons/site.webmanifest" />
    <link rel="mask-icon" href="/static/favicons/safari-pinned-tab.svg" color="#5bbad5" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteMetadata.title} />
    <meta property="og:locale" content={siteMetadata.locale.replace('-', '_')} />
    <meta property="og:description" content={description} />
    <meta property="og:title" content={title} />
    {absoluteOgImages.map((image, index) => (
      <>
        <meta property="og:image" content={image} />
        <meta property="og:image:alt" content={ogImageAlt} />
        {imageMetadata[index]?.width && (
          <meta property="og:image:width" content={String(imageMetadata[index].width)} />
        )}
        {imageMetadata[index]?.height && (
          <meta property="og:image:height" content={String(imageMetadata[index].height)} />
        )}
        {imageMetadata[index]?.type && (
          <meta property="og:image:type" content={imageMetadata[index].type} />
        )}
      </>
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={siteMetadata.twitterHandle} />
    <meta name="twitter:creator" content={siteMetadata.twitterHandle} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImages[0]} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {articlePublished && <meta property="article:published_time" content={articlePublished} />}
    {articleModified && <meta property="article:modified_time" content={articleModified} />}
    {articleSection && <meta property="article:section" content={articleSection} />}
    {articleTags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    {structuredData && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')}
      />
    )}
    <script is:inline set:html={themeHeadScript} />
  </head>
  <body class="overflow-x-clip bg-white text-black antialiased dark:bg-gray-900 dark:text-white">
    <header
      class="fixed inset-x-0 top-0 z-50 bg-white dark:bg-gray-900"
      transition:persist="site-header"
    >
      <div class="mx-auto flex h-14 max-w-3xl items-center justify-between gap-4 px-4 text-sm text-gray-900 sm:px-6 xl:max-w-5xl xl:px-0 dark:text-gray-100">
        <a
          href="/"
          aria-label={siteMetadata.headerTitle}
          class="flex min-w-0 items-center gap-2 font-medium"
        >
          <span class="h-5 w-5 shrink-0 [&_svg]:h-5 [&_svg]:w-5" set:html={logo} />
          <span class="truncate">{siteMetadata.headerTitle}</span>
        </a>
        <nav class="hidden items-center sm:flex" aria-label="Main navigation">
          {navLinks.map((link) => (
            <a href={link.href} class="px-3 py-2 font-medium">
              {link.title}
            </a>
          ))}
        </nav>
        <button
          id="mobile-nav-toggle"
          type="button"
          aria-label="Toggle Menu"
          aria-expanded="false"
          class="inline-flex h-10 w-10 shrink-0 items-center justify-center sm:hidden"
        >
          <svg
            id="mobile-nav-open-icon"
            class="h-5 w-5"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
              clip-rule="evenodd"
            />
          </svg>
          <svg
            id="mobile-nav-close-icon"
            class="hidden h-5 w-5"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
              clip-rule="evenodd"
            />
          </svg>
        </button>
      </div>
    </header>
    <div
      id="mobile-nav"
      class="fixed inset-x-0 top-14 z-40 translate-x-full bg-gray-900 text-gray-100 transition-transform duration-300 ease-in-out dark:bg-white dark:text-gray-900 sm:hidden"
      aria-hidden="true"
      transition:persist="site-nav"
    >
      <nav
        class="mx-auto flex max-w-3xl flex-col px-4 pt-2 pb-4 sm:px-6 xl:max-w-5xl xl:px-0"
        aria-label="Mobile navigation"
      >
        {navLinks.map((link) => (
          <a href={link.href} data-mobile-nav-link class="py-3 text-base font-medium text-current">
            {link.title}
          </a>
        ))}
      </nav>
    </div>
    <div class="mx-auto max-w-3xl px-4 pt-14 sm:px-6 xl:max-w-5xl xl:px-0">
      <div class="flex min-h-screen flex-col justify-between">
        <main class="mb-auto" transition:animate={pageTransition}>
          <slot />
        </main>
        <footer
          class="mt-16 border-t border-gray-200 py-6 dark:border-gray-800"
          transition:persist="site-footer"
        >
          <div>
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <nav
                aria-label="Footer"
                class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-gray-500 dark:text-gray-400"
              >
                {footerLinks.map((link) => (
                  <a
                    href={link.href}
                    class="font-medium hover:text-primary-500 dark:hover:text-primary-400"
                  >
                    {link.title}
                  </a>
                ))}
              </nav>
              <div class="flex items-center gap-3">
                <nav aria-label="Social links" class="flex max-w-full flex-wrap items-center gap-2">
                  <SocialLinks
                    links={footerSocials}
                    linkClass={socialLinkClass}
                    iconClass="h-4 w-4"
                  />
                </nav>
                <div
                  id="theme-switcher"
                  class="inline-flex w-fit rounded-full border border-gray-300 bg-transparent p-0.5 dark:border-gray-700"
                  role="radiogroup"
                  aria-label="Theme"
                >
                  <button
                    type="button"
                    data-theme="light"
                    aria-label="Light"
                    class="theme-option inline-flex h-5 w-5 items-center justify-center rounded-full bg-transparent text-gray-500 outline-none dark:text-gray-400"
                    role="radio"
                  >
                    <svg
                      class="h-3 w-3"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="4"></circle>
                      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
                    </svg>
                  </button>
                  <button
                    type="button"
                    data-theme="dark"
                    aria-label="Dark"
                    class="theme-option inline-flex h-5 w-5 items-center justify-center rounded-full bg-transparent text-gray-500 outline-none dark:text-gray-400"
                    role="radio"
                  >
                    <svg
                      class="h-3 w-3"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z"></path>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
            <div class="mt-4 text-sm text-gray-400 dark:text-gray-500">
              <span>
                © {new Date().getFullYear()} · {siteMetadata.title}
              </span>
            </div>
          </div>
        </footer>
      </div>
    </div>
    <style>
      .theme-option[aria-checked='true'] {
        background: #f5f5f5;
        color: #171717;
      }

      :global(.dark) .theme-option[aria-checked='true'] {
        background: #171717;
        color: #fff;
      }

      header.menu-open,
      header.menu-open > div {
        background: #171717;
        color: #f5f5f5;
      }

      :global(.dark) header.menu-open,
      :global(.dark) header.menu-open > div {
        background: #fff;
        color: #171717;
      }
    </style>
    <script>
      import { resolveTheme, storeTheme, syncThemeSwitcher } from '../lib/theme'

      const themeSwitcher = document.getElementById('theme-switcher')
      if (themeSwitcher instanceof HTMLElement && themeSwitcher.dataset.bound !== 'true') {
        themeSwitcher.dataset.bound = 'true'
        themeSwitcher.addEventListener('click', (event) => {
          const button = (event.target as Element | null)?.closest('[data-theme]')
          const theme = button?.getAttribute('data-theme')
          if (theme === 'light' || theme === 'dark') storeTheme(theme)
        })
        syncThemeSwitcher(resolveTheme())
      }

      const showMobileNav = (show: boolean) => {
        const navToggle = document.getElementById('mobile-nav-toggle')
        const mobileNav = document.getElementById('mobile-nav')
        const siteHeader = document.querySelector('header')
        const openIcon = document.getElementById('mobile-nav-open-icon')
        const closeIcon = document.getElementById('mobile-nav-close-icon')
        if (!navToggle || !mobileNav || !siteHeader || !openIcon || !closeIcon) return
        mobileNav.classList.toggle('translate-x-0', show)
        mobileNav.classList.toggle('translate-x-full', !show)
        mobileNav.setAttribute('aria-hidden', String(!show))
        navToggle.setAttribute('aria-expanded', String(show))
        openIcon.classList.toggle('hidden', show)
        closeIcon.classList.toggle('hidden', !show)
        siteHeader.classList.toggle('menu-open', show)
      }

      document.addEventListener('click', (event) => {
        const target = event.target
        if (!(target instanceof Element)) return
        const toggle = target.closest('#mobile-nav-toggle')
        if (toggle) {
          showMobileNav(toggle.getAttribute('aria-expanded') !== 'true')
          return
        }
        if (target.closest('[data-mobile-nav-link]')) showMobileNav(false)
      })
      document.addEventListener('astro:before-preparation', () => showMobileNav(false))
      document.addEventListener('astro:after-swap', () => showMobileNav(false))
    </script>
  </body>
</html>
