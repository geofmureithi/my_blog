{
  "name": "tailwind-nextjs-starter-blog",
  "version": "1.5.3",
  "private": true,
  "scripts": {
    "start": "next dev --webpack",
    "dev": "contentlayer2 dev & next dev --webpack",
    "build": "contentlayer2 build && next build --webpack",
    "postbuild": "pnpm run sitemap && pnpm run rss",
    "sitemap": "cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/generate-sitemap.mjs",
    "rss": "cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/generate-rss.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "lint": "eslint pages components lib layouts scripts",
    "prepare": "husky install"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "^5.1.0",
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.20",
    "contentlayer2": "^0.5.8",
    "esbuild": "^0.25.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "image-size": "^1.2.0",
    "js-yaml": "^4.1.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "^16.4.2",
    "next-contentlayer2": "^0.5.8",
    "next-themes": "^0.4.4",
    "postcss": "^8.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.2.2",
    "rehype-katex": "^7.0.1",
    "rehype-preset-minify": "^7.0.1",
    "rehype-prism-plus": "^2.0.0",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@next/bundle-analyzer": "^16.4.2",
    "@svgr/webpack": "^8.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.13.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^2.0.10",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "cross-env": "^7.0.3",
    "dedent": "^1.5.3",
    "eslint": "^9.21.0",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "globby": "^14.1.0",
    "husky": "^9.1.7",
    "inquirer": "^12.4.2",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.8.2",
    "vfile": "^6.0.3"
  }
}