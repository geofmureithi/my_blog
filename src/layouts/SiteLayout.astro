---
import { ClientRouter } from 'astro:transitions'
import '@fontsource/inter/variable-full.css'
import '../styles/global.css'
import '../styles/prism.css'
import logo from '../assets/logo.svg?raw'
import siteMetadata from '../data/site-metadata'

interface Props {
  title?: string
  description?: string
  robots?: string
  canonical?: string
  ogType?: string
  ogImage?: string
  ogImages?: string[]
  ogImageAlt?: string
  ogImageMetadata?: Array<{ width?: number; height?: number; type?: string }>
  articlePublished?: string
  articleModified?: string
  articleSection?: string
  articleTags?: string[]
  structuredData?: Record<string, unknown>
  tagFeedHref?: string
  tagFeedTitle?: string
}

const canonicalPath = Astro.url.pathname.replace(/\/index(?:\.html)?$/, '/').replace(/\.html$/, '')
const {
  title = siteMetadata.title,
  description = siteMetadata.description,
  robots = 'index, follow, max-image-preview:large',
  canonical = siteMetadata.siteUrl + canonicalPath,
  ogType = 'website',
  ogImage,
  ogImages,
  ogImageAlt = `${title} — ${siteMetadata.author}`,
  ogImageMetadata,
  articlePublished,
  articleModified,
  articleSection,
  articleTags = [],
  structuredData,
  tagFeedHref,
  tagFeedTitle,
} = Astro.props as Props
const imageSources = ogImages ?? [ogImage ?? siteMetadata.socialBanner]
const absoluteOgImages = imageSources.map(
  (image) => new URL(image, siteMetadata.ogImageBaseUrl).href
)
const defaultImageMetadata = [{ width: 1200, height: 600, type: 'image/png' }]
const imageMetadata =
  ogImageMetadata ??
  (imageSources.length === 1 && imageSources[0] === siteMetadata.socialBanner
    ? defaultImageMetadata
    : [])
const navLinks = [
  { href: '/blog', title: 'Blog' },
  { href: '/projects', title: 'Projects' },
  { href: '/about', title: 'About' },
]
const footerLinks = [
  { href: '/blog', title: 'Blog' },
  { href: '/tags', title: 'Tags' },
  { href: '/projects', title: 'Projects' },
  { href: '/about', title: 'About' },
]
const socialLinkClass =
  'inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-gray-600 transition hover:border-primary-400 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:outline-none dark:border-gray-300 dark:hover:border-primary-500'
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robots} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={siteMetadata.title} href="/feed.xml" />
    {tagFeedHref && (
      <link rel="alternate" type="application/rss+xml" title={tagFeedTitle} href={tagFeedHref} />
    )}
    <link rel="apple-touch-icon" sizes="76x76" href="/static/favicons/apple-touch-icon.png" />
    <link rel="icon" href="/static/favicons/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/static/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/static/favicons/favicon-16x16.png" />
    <link rel="manifest" href="/static/favicons/site.webmanifest" />
    <link rel="mask-icon" href="/static/favicons/safari-pinned-tab.svg" color="#5bbad5" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteMetadata.title} />
    <meta property="og:locale" content={siteMetadata.locale.replace('-', '_')} />
    <meta property="og:description" content={description} />
    <meta property="og:title" content={title} />
    {absoluteOgImages.map((image, index) => (
      <>
        <meta property="og:image" content={image} />
        <meta property="og:image:alt" content={ogImageAlt} />
        {imageMetadata[index]?.width && (
          <meta property="og:image:width" content={String(imageMetadata[index].width)} />
        )}
        {imageMetadata[index]?.height && (
          <meta property="og:image:height" content={String(imageMetadata[index].height)} />
        )}
        {imageMetadata[index]?.type && (
          <meta property="og:image:type" content={imageMetadata[index].type} />
        )}
      </>
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={siteMetadata.twitterHandle} />
    <meta name="twitter:creator" content={siteMetadata.twitterHandle} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImages[0]} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {articlePublished && <meta property="article:published_time" content={articlePublished} />}
    {articleModified && <meta property="article:modified_time" content={articleModified} />}
    {articleSection && <meta property="article:section" content={articleSection} />}
    {articleTags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    {structuredData && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')}
      />
    )}
    <script is:inline>
      const savedTheme = localStorage.getItem('theme')
      const theme =
        savedTheme === 'light' || savedTheme === 'dark'
          ? savedTheme
          : window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light'
      document.documentElement.classList.toggle('dark', theme === 'dark')
    </script>
  </head>
  <body class="overflow-x-clip bg-white text-black antialiased dark:bg-gray-900 dark:text-white">
    <header
      class="fixed inset-x-0 top-0 z-50 bg-white dark:bg-gray-900"
      transition:persist="site-header"
    >
      <div class="mx-auto flex h-14 max-w-3xl items-center justify-between gap-4 px-4 text-sm text-gray-900 sm:px-6 xl:max-w-5xl xl:px-0 dark:text-gray-100">
        <a
          href="/"
          aria-label={siteMetadata.headerTitle}
          class="flex min-w-0 items-center gap-2 font-medium"
        >
          <span class="h-5 w-5 shrink-0 [&_svg]:h-5 [&_svg]:w-5" set:html={logo} />
          <span class="truncate">{siteMetadata.headerTitle}</span>
        </a>
        <nav class="hidden items-center sm:flex" aria-label="Main navigation">
          {navLinks.map((link) => (
            <a href={link.href} class="px-3 py-2 font-medium">
              {link.title}
            </a>
          ))}
        </nav>
        <button
          id="mobile-nav-toggle"
          type="button"
          aria-label="Toggle Menu"
          aria-expanded="false"
          class="inline-flex h-10 w-10 shrink-0 items-center justify-center sm:hidden"
        >
          <svg
            id="mobile-nav-open-icon"
            class="h-5 w-5"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
              clip-rule="evenodd"
            />
          </svg>
          <svg
            id="mobile-nav-close-icon"
            class="hidden h-5 w-5"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
              clip-rule="evenodd"
            />
          </svg>
        </button>
      </div>
    </header>
    <div
      id="mobile-nav"
      class="fixed inset-x-0 top-14 z-40 translate-x-full bg-gray-900 text-gray-100 transition-transform duration-300 ease-in-out dark:bg-white dark:text-gray-900 sm:hidden"
      aria-hidden="true"
      transition:persist="site-nav"
    >
      <nav
        class="mx-auto flex max-w-3xl flex-col px-4 pt-2 pb-4 sm:px-6 xl:max-w-5xl xl:px-0"
        aria-label="Mobile navigation"
      >
        {navLinks.map((link) => (
          <a href={link.href} data-mobile-nav-link class="py-3 text-base font-medium text-current">
            {link.title}
          </a>
        ))}
      </nav>
    </div>
    <div class="mx-auto max-w-3xl px-4 pt-14 sm:px-6 xl:max-w-5xl xl:px-0">
      <div class="flex min-h-screen flex-col justify-between">
        <main class="mb-auto" transition:animate="fade">
          <slot />
        </main>
        <footer
          class="relative left-1/2 mt-24 w-screen -translate-x-1/2 overflow-hidden bg-gray-900 pt-10 pb-8 text-gray-100 dark:bg-white dark:text-gray-900"
          transition:persist="site-footer"
        >
          <div class="mx-auto max-w-3xl px-4 sm:px-6 xl:max-w-5xl xl:px-0">
            <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <p class="text-sm font-semibold uppercase tracking-[0.22em] text-current">
                  Nairobi
                </p>
                <p class="mt-3 max-w-xs text-sm leading-6 text-gray-400 dark:text-gray-600">
                  {siteMetadata.description}
                </p>
              </div>
              <div class="flex flex-col gap-6 sm:items-end">
                <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2">
                  {footerLinks.map((link) => (
                    <a
                      href={link.href}
                      class="text-sm font-medium text-gray-100 hover:text-primary-400 dark:text-gray-800 dark:hover:text-primary-500"
                    >
                      {link.title}
                    </a>
                  ))}
                </nav>
                <nav
                  aria-label="Social links"
                  class="flex max-w-full flex-wrap items-center gap-3 text-gray-100 dark:text-gray-900"
                >
                  <a
                    href={'mailto:' + siteMetadata.email}
                    aria-label="Email"
                    class={socialLinkClass}
                  >
                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z"></path>
                      <path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z"></path>
                    </svg>
                  </a>
                  <a href={siteMetadata.github} aria-label="GitHub" class={socialLinkClass}>
                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
                    </svg>
                  </a>
                  <a href={siteMetadata.linkedin} aria-label="LinkedIn" class={socialLinkClass}>
                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
                    </svg>
                  </a>
                  <a href={siteMetadata.twitter} aria-label="X" class={socialLinkClass}>
                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M18.901 1.153h3.68L14.54 10.457 24 22.848h-7.406l-5.8-7.584-6.638 7.584H.474l8.58-9.814L0 1.153h7.594l5.241 6.932zm-1.295 19.5h2.039L6.486 3.233h-2.19z"></path>
                    </svg>
                  </a>
                  <a href={siteMetadata.sessionize} aria-label="Sessionize" class={socialLinkClass}>
                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 0c6.628 0 12 5.372 12 12v10c0 1.097-.903 2-2 2h-7.5l-.001-.169c-.049-2.894-1.347-4.902-3.709-5.96L24 12l-.32-.109Q19.393 10.393 16.5 7.5T12.109.319zL4 18q0 1 .5 1.5q.501.5 1.5.5l.187.001c3.771.04 5.313 1.295 5.313 3.999H2c-1.097 0-2-.903-2-2V2C0 .903.903 0 2 0zm7.207 4.793c-.781-.781-1.73-1.097-2.121-.707c-.39.39-.074 1.34.707 2.121s1.731 1.098 2.121.707c.391-.39.074-1.34-.707-2.121"></path>
                    </svg>
                  </a>
                </nav>
                <div
                  id="theme-switcher"
                  class="inline-flex w-fit rounded-full border border-gray-600 bg-transparent p-0.5 dark:border-gray-300"
                  role="radiogroup"
                  aria-label="Theme"
                >
                  <button
                    type="button"
                    data-theme="light"
                    aria-label="Light"
                    class="theme-option inline-flex h-5 w-5 items-center justify-center rounded-full bg-transparent text-gray-100 outline-none dark:text-gray-900"
                    role="radio"
                  >
                    <svg
                      class="h-3 w-3"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="4"></circle>
                      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
                    </svg>
                  </button>
                  <button
                    type="button"
                    data-theme="dark"
                    aria-label="Dark"
                    class="theme-option inline-flex h-5 w-5 items-center justify-center rounded-full bg-transparent text-gray-100 outline-none dark:text-gray-900"
                    role="radio"
                  >
                    <svg
                      class="h-3 w-3"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z"></path>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
            <a
              href="/"
              class="mt-12 block text-[clamp(4.25rem,17vw,11.5rem)] leading-[0.8] font-extrabold tracking-[-0.07em] text-current"
            >
              Njuguna
            </a>
            <div class="mt-6 flex flex-col gap-2 text-sm text-gray-400 sm:flex-row sm:items-center sm:justify-between dark:text-gray-500">
              <span>© {new Date().getFullYear()}</span>
              <span>{siteMetadata.title}</span>
            </div>
          </div>
        </footer>
      </div>
    </div>
    <style>
      .theme-option[aria-checked='true'] {
        background: #f5f5f5;
        color: #171717;
      }

      :global(.dark) .theme-option[aria-checked='true'] {
        background: #171717;
        color: #fff;
      }

      header.menu-open,
      header.menu-open > div {
        background: #171717;
        color: #f5f5f5;
      }

      :global(.dark) header.menu-open,
      :global(.dark) header.menu-open > div {
        background: #fff;
        color: #171717;
      }
    </style>
    <script is:inline>
      const themeSwitcher = document.getElementById('theme-switcher')
      if (themeSwitcher && !themeSwitcher.dataset.bound) {
        themeSwitcher.dataset.bound = 'true'
        const savedTheme = localStorage.getItem('theme')
        const applyTheme = (theme) => {
          document.documentElement.classList.toggle('dark', theme === 'dark')
          localStorage.setItem('theme', theme)
          themeSwitcher.querySelectorAll('[data-theme]').forEach((button) => {
            button.setAttribute('aria-checked', String(button.dataset.theme === theme))
          })
          const frame = document.querySelector('iframe.giscus-frame')
          if (frame?.contentWindow) {
            frame.style.colorScheme = theme
            frame.style.background = theme === 'dark' ? '#171717' : '#fff'
            frame.contentWindow.postMessage(
              { giscus: { setConfig: { theme: `${window.location.origin}/giscus-${theme}.css` } } },
              'https://giscus.app'
            )
          }
        }
        themeSwitcher.addEventListener('click', (event) => {
          const button = event.target.closest('[data-theme]')
          if (button) applyTheme(button.dataset.theme)
        })
        applyTheme(
          savedTheme === 'light' || savedTheme === 'dark'
            ? savedTheme
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light'
        )
      }

      const showMobileNav = (show) => {
        const navToggle = document.getElementById('mobile-nav-toggle')
        const mobileNav = document.getElementById('mobile-nav')
        const siteHeader = document.querySelector('header')
        if (!navToggle || !mobileNav || !siteHeader) return
        mobileNav.classList.toggle('translate-x-0', show)
        mobileNav.classList.toggle('translate-x-full', !show)
        mobileNav.setAttribute('aria-hidden', String(!show))
        navToggle.setAttribute('aria-expanded', String(show))
        document.getElementById('mobile-nav-open-icon').classList.toggle('hidden', show)
        document.getElementById('mobile-nav-close-icon').classList.toggle('hidden', !show)
        siteHeader.classList.toggle('menu-open', show)
      }

      if (!window.__siteNavBound) {
        window.__siteNavBound = true
        document.addEventListener('click', (event) => {
          const toggle = event.target.closest('#mobile-nav-toggle')
          if (toggle) {
            showMobileNav(toggle.getAttribute('aria-expanded') !== 'true')
            return
          }
          if (event.target.closest('[data-mobile-nav-link]')) showMobileNav(false)
        })
        document.addEventListener('astro:before-preparation', () => showMobileNav(false))
        document.addEventListener('astro:after-swap', () => showMobileNav(false))
      }
    </script>
  </body>
</html>
