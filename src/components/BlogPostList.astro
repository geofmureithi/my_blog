---
import { formatDate } from '../lib/format-date'
import {
  articleSearchEmptyId,
  articleSearchInputId,
  articleSearchText,
} from '../lib/article-search'
import { tagSlug } from '../lib/tags'
import EmptyState from './EmptyState.astro'
import ReadMoreIcon from './icons/ReadMore.astro'
import SearchIcon from './icons/Search.astro'
import { pageTransition } from '../lib/page-transition'

interface Props {
  posts: Array<{
    id: string
    data: {
      title: string
      date: Date
      tags: string[]
      summary?: string
    }
  }>
  title: string
  description?: string
  search?: boolean
}

const { posts, title, description, search = true } = Astro.props as Props
const emptyMessage = posts.length === 0 ? 'No articles yet.' : 'No articles match that search.'
---

<div>
  <header class="pt-6">
    <h1 class="text-3xl font-extrabold leading-9 tracking-tight text-gray-900 sm:text-4xl sm:leading-10 md:text-6xl md:leading-14 dark:text-gray-100">
      {title}
    </h1>
    {description && <p class="mt-2 text-gray-500 dark:text-gray-400">{description}</p>}
    {search && (
      <div class="relative mt-6 max-w-sm">
        <label class="sr-only" for={articleSearchInputId}>
          Search articles
        </label>
        <input
          id={articleSearchInputId}
          type="search"
          placeholder="Search articles"
          autocomplete="off"
          class="block w-full rounded-lg border border-gray-300 bg-transparent py-1.5 pr-9 pl-3 text-sm text-gray-900 placeholder-gray-500 focus:border-primary-500 focus:outline-none dark:border-gray-600 dark:text-gray-100 dark:placeholder-gray-400"
        />
        <SearchIcon
          aria-hidden="true"
          class="pointer-events-none absolute top-1/2 right-3 h-4 w-4 -translate-y-1/2 text-gray-500"
        />
      </div>
    )}
  </header>
  <ul
    id="article-list"
    class="mt-8 flex flex-col gap-8 empty:hidden [&:not(:has([data-article]:not([hidden])))]:hidden"
  >
    {posts.map((post) => (
      <li data-article data-search={articleSearchText(post.data)}>
        <article>
          <div class="flex items-baseline justify-between gap-4">
            <h3
              class="min-w-0 text-xl font-bold tracking-tight text-gray-900 dark:text-gray-100"
              transition:name={`post-${post.id}`}
              transition:animate={pageTransition}
            >
              <a class="hover:text-primary-500" href={`/blog/${post.id}`}>
                {post.data.title}
              </a>
            </h3>
            <time
              datetime={post.data.date.toISOString()}
              class="shrink-0 text-sm text-gray-500 dark:text-gray-400"
            >
              {formatDate(post.data.date)}
            </time>
          </div>
          <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
            {post.data.tags.map((tag) => (
              <a
                href={`/tags/${tagSlug(tag)}`}
                class="text-xs font-medium uppercase tracking-wide text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
              >
                {tag}
              </a>
            ))}
          </div>
          {post.data.summary && (
            <p class="mt-3 text-sm leading-6 text-gray-500 dark:text-gray-400">
              {post.data.summary}
            </p>
          )}
          <a
            href={`/blog/${post.id}`}
            aria-label={`Read ${post.data.title}`}
            class="mt-4 inline-flex w-fit items-center rounded-lg border border-gray-300 px-3 py-1.5 text-sm font-semibold text-gray-900 hover:border-primary-500 dark:border-gray-600 dark:text-gray-100 dark:hover:border-primary-400"
          >
            Read more
            <ReadMoreIcon class="ml-1 h-5 w-5" aria-hidden="true" />
          </a>
        </article>
      </li>
    ))}
  </ul>
  {(search || posts.length === 0) && (
    <EmptyState id={articleSearchEmptyId} hidden={posts.length > 0}>
      {emptyMessage}
    </EmptyState>
  )}
</div>
