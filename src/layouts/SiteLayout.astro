---
import '@fontsource/inter/variable-full.css'
import '../styles/global.css'
import '../styles/prism.css'
import logo from '../assets/logo.svg?raw'
import siteMetadata from '../data/site-metadata'

interface Props {
  title?: string
  description?: string
  canonical?: string
  ogType?: string
  ogImage?: string
  ogImages?: string[]
  ogImageAlt?: string
  ogImageMetadata?: Array<{ width?: number; height?: number; type?: string }>
  articlePublished?: string
  articleModified?: string
  articleSection?: string
  articleTags?: string[]
  structuredData?: Record<string, unknown>
  tagFeedHref?: string
  tagFeedTitle?: string
}

const canonicalPath = Astro.url.pathname.replace(/\/index(?:\.html)?$/, '/').replace(/\.html$/, '')
const {
  title = siteMetadata.title,
  description = siteMetadata.description,
  canonical = siteMetadata.siteUrl + canonicalPath,
  ogType = 'website',
  ogImage,
  ogImages,
  ogImageAlt = `${title} — ${siteMetadata.author}`,
  ogImageMetadata,
  articlePublished,
  articleModified,
  articleSection,
  articleTags = [],
  structuredData,
  tagFeedHref,
  tagFeedTitle,
} = Astro.props as Props
const imageSources = ogImages ?? [ogImage ?? siteMetadata.socialBanner]
const absoluteOgImages = imageSources.map((image) => new URL(image, siteMetadata.siteUrl).href)
const defaultImageMetadata = [{ width: 1200, height: 600, type: 'image/png' }]
const imageMetadata =
  ogImageMetadata ??
  (imageSources.length === 1 && imageSources[0] === siteMetadata.socialBanner
    ? defaultImageMetadata
    : [])
const navLinks = [
  { href: '/blog', title: 'Blog' },
  { href: '/tags', title: 'Tags' },
  { href: '/projects', title: 'Projects' },
  { href: '/about', title: 'About' },
]
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={siteMetadata.title} href="/feed.xml" />
    {tagFeedHref && (
      <link rel="alternate" type="application/rss+xml" title={tagFeedTitle} href={tagFeedHref} />
    )}
    <link rel="apple-touch-icon" sizes="76x76" href="/static/favicons/apple-touch-icon.png" />
    <link rel="icon" href="/static/favicons/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/static/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/static/favicons/favicon-16x16.png" />
    <link rel="manifest" href="/static/favicons/site.webmanifest" />
    <link rel="mask-icon" href="/static/favicons/safari-pinned-tab.svg" color="#5bbad5" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteMetadata.title} />
    <meta property="og:locale" content={siteMetadata.locale.replace('-', '_')} />
    <meta property="og:description" content={description} />
    <meta property="og:title" content={title} />
    {absoluteOgImages.map((image, index) => (
      <>
        <meta property="og:image" content={image} />
        <meta property="og:image:alt" content={ogImageAlt} />
        {imageMetadata[index]?.width && (
          <meta property="og:image:width" content={String(imageMetadata[index].width)} />
        )}
        {imageMetadata[index]?.height && (
          <meta property="og:image:height" content={String(imageMetadata[index].height)} />
        )}
        {imageMetadata[index]?.type && (
          <meta property="og:image:type" content={imageMetadata[index].type} />
        )}
      </>
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={siteMetadata.twitterHandle} />
    <meta name="twitter:creator" content={siteMetadata.twitterHandle} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImages[0]} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {articlePublished && <meta property="article:published_time" content={articlePublished} />}
    {articleModified && <meta property="article:modified_time" content={articleModified} />}
    {articleSection && <meta property="article:section" content={articleSection} />}
    {articleTags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    {structuredData && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')}
      />
    )}
    <script is:inline>
      const savedTheme = localStorage.getItem('theme') || 'system'
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches
      document.documentElement.classList.toggle(
        'dark',
        savedTheme === 'dark' || (savedTheme === 'system' && systemDark)
      )
    </script>
  </head>
  <body class="bg-white text-black antialiased dark:bg-gray-900 dark:text-white">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 xl:max-w-5xl xl:px-0">
      <div class="flex min-h-screen flex-col justify-between">
        <header class="flex items-center justify-between py-10">
          <a href="/" aria-label={siteMetadata.headerTitle}>
            <div class="flex items-center justify-between">
              <span class="mr-3 h-12 w-12 text-gray-900 dark:text-gray-100" set:html={logo} />
              <span class="hidden h-6 text-2xl font-semibold sm:block">
                {siteMetadata.headerTitle}
              </span>
            </div>
          </a>
          <div class="flex items-center text-base leading-5">
            <nav class="hidden sm:block" aria-label="Main navigation">
              {navLinks.map((link) => (
                <a href={link.href} class="p-1 font-medium text-gray-900 dark:text-gray-100 sm:p-4">
                  {link.title}
                </a>
              ))}
            </nav>
            <button
              id="theme-toggle"
              aria-label="Toggle Dark Mode"
              type="button"
              class="ml-1 mr-1 h-8 w-8 rounded p-1 text-gray-900 dark:text-gray-100 sm:ml-4"
            >
              <svg
                class="h-6 w-6 dark:hidden"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
              </svg>
              <svg
                class="hidden h-6 w-6 dark:block"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 100 2h1z"
                  clip-rule="evenodd"
                />
              </svg>
            </button>
            <div class="sm:hidden">
              <button
                id="mobile-nav-toggle"
                type="button"
                aria-label="Toggle Menu"
                aria-expanded="false"
                class="ml-1 mr-1 h-8 w-8 rounded py-1"
              >
                <svg
                  id="mobile-nav-open-icon"
                  class="h-6 w-6 text-gray-900 dark:text-gray-100"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                >
                  <path
                    fill-rule="evenodd"
                    d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
                    clip-rule="evenodd"
                  />
                </svg>
                <svg
                  id="mobile-nav-close-icon"
                  class="hidden h-6 w-6 text-gray-900 dark:text-gray-100"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                >
                  <path
                    fill-rule="evenodd"
                    d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                    clip-rule="evenodd"
                  />
                </svg>
              </button>
            </div>
          </div>
        </header>
        <div
          id="mobile-nav"
          class="fixed top-24 right-0 z-10 h-full w-full translate-x-full transform bg-gray-200 opacity-95 duration-300 ease-in-out dark:bg-gray-800 sm:hidden"
          aria-hidden="true"
        >
          <button
            id="mobile-nav-backdrop"
            type="button"
            aria-label="Close menu"
            class="fixed h-full w-full cursor-auto focus:outline-hidden"
          ></button>
          <nav class="fixed mt-8 h-full" aria-label="Mobile navigation">
            {navLinks.map((link) => (
              <div class="px-12 py-4">
                <a
                  href={link.href}
                  data-mobile-nav-link
                  class="text-2xl font-bold tracking-widest text-gray-900 dark:text-gray-100"
                >
                  {link.title}
                </a>
              </div>
            ))}
          </nav>
        </div>
        <main class="mb-auto">
          <slot />
        </main>
        <footer>
          <div class="mt-16 flex flex-col items-center">
            <div class="mb-3 flex space-x-4">
              <a href={'mailto:' + siteMetadata.email} aria-label="mail">
                <img class="h-6 w-6 dark:invert" src="/icons/mail.svg" alt="" />
              </a>
              <a href={siteMetadata.github} aria-label="github">
                <img class="h-6 w-6 dark:invert" src="/icons/github.svg" alt="" />
              </a>
              <a href={siteMetadata.linkedin} aria-label="linkedin">
                <img class="h-6 w-6 dark:invert" src="/icons/linkedin.svg" alt="" />
              </a>
              <a href={siteMetadata.twitter} aria-label="X">
                <img class="h-6 w-6 dark:invert" src="/icons/x.svg" alt="" />
              </a>
            </div>
            <div class="mb-2 flex space-x-2 text-sm text-gray-500 dark:text-gray-400">
              <span>{siteMetadata.author}</span>
              <span>•</span>
              <span>© {new Date().getFullYear()}</span>
              <span>•</span>
              <a href="/">{siteMetadata.title}</a>
            </div>
          </div>
        </footer>
      </div>
    </div>
    <script is:inline>
      const themeToggle = document.getElementById('theme-toggle')
      themeToggle.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark')
        const nextTheme = isDark ? 'light' : 'dark'
        localStorage.setItem('theme', nextTheme)
        document.documentElement.classList.toggle('dark', nextTheme === 'dark')
      })

      const navToggle = document.getElementById('mobile-nav-toggle')
      const mobileNav = document.getElementById('mobile-nav')
      const showMobileNav = (show) => {
        mobileNav.classList.toggle('translate-x-0', show)
        mobileNav.classList.toggle('translate-x-full', !show)
        mobileNav.setAttribute('aria-hidden', String(!show))
        navToggle.setAttribute('aria-expanded', String(show))
        document.getElementById('mobile-nav-open-icon').classList.toggle('hidden', show)
        document.getElementById('mobile-nav-close-icon').classList.toggle('hidden', !show)
        document.body.style.overflow = show ? 'hidden' : 'auto'
      }

      navToggle.addEventListener('click', () => {
        showMobileNav(navToggle.getAttribute('aria-expanded') !== 'true')
      })
      document
        .getElementById('mobile-nav-backdrop')
        .addEventListener('click', () => showMobileNav(false))
      document.querySelectorAll('[data-mobile-nav-link]').forEach((link) => {
        link.addEventListener('click', () => showMobileNav(false))
      })
    </script>
  </body>
</html>
