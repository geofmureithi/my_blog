---
import { getCollection } from 'astro:content'
import SiteLayout from '../../layouts/SiteLayout.astro'
import siteMetadata from '../../data/site-metadata'
import { uniqueTags } from '../../lib/tags'

const posts = await getCollection('blog', ({ data }) => !data.draft)
const counts = new Map<string, { tag: string; count: number }>()
for (const post of posts) {
  for (const { slug, tag } of uniqueTags(post.data.tags)) {
    const current = counts.get(slug)
    counts.set(slug, { tag: current?.tag ?? tag, count: (current?.count ?? 0) + 1 })
  }
}
const tags = [...counts].toSorted((a, b) => b[1].count - a[1].count)
---

<SiteLayout title={`Tags - ${siteMetadata.author}`} description="Things I blog about">
  <div class="flex flex-col items-start justify-start divide-y divide-gray-200 dark:divide-gray-700 md:mt-24 md:flex-row md:items-center md:justify-center md:space-x-6 md:divide-y-0">
    <header class="space-x-2 pt-6 pb-8 md:space-y-5">
      <h1 class="text-3xl font-extrabold leading-9 tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl sm:leading-10 md:border-r-2 md:px-6 md:text-6xl md:leading-14">
        Tags
      </h1>
    </header>
    <div class="flex max-w-lg flex-wrap">
      {tags.map(([slug, { tag, count }]) => (
        <div class="mt-2 mb-2 mr-5">
          <a
            href={`/tags/${slug}`}
            class="mr-1 text-sm font-medium uppercase text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
          >
            {tag}
          </a>
          <a href={`/tags/${slug}`} class="text-sm font-medium text-gray-500 dark:text-gray-400">
            {' '}
            ({count})
          </a>
        </div>
      ))}
    </div>
  </div>
</SiteLayout>
